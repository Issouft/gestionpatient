# Modèle du fichier .env. Copiez-le avec : cp .env.example .env
# Puis remplacez chaque valeur par la vôtre. Ne commitez jamais .env : il contient vos secrets.
# Détails de chaque ligne : README, section 1, « Étape 3 : créer le fichier .env ».

# Mot de passe de VOTRE PostgreSQL (utilisateur postgres). Obligatoire.
spring.datasource.password=le_mot_de_passe_de_votre_PostgreSQL

# Clé qui signe les jetons de connexion. Obligatoire. Générez-la avec : openssl rand -hex 64
JWT_SECRET=une_longue_suite_de_caracteres_aleatoires

# Compte Gmail qui envoie les emails (activation, mot de passe oublié).
# Le mot de passe est un « mot de passe d'application » de 16 lettres, sans espaces, pas celui de Gmail.
spring.mail.username=votre.adresse@gmail.com
spring.mail.password=le_mot_de_passe_d_application_gmail

# Email du super-administrateur : une adresse NEUVE dont vous lisez les emails.
# Pas de mot de passe ici : il le choisit depuis le lien reçu par email.
super-administrateur.email=email_du_super_administrateur
